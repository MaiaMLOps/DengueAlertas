# Environment variables
.env
.env.local

# Personal Claude Code settings
.claude/settings.local.json

# Python cache
__pycache__/
*.py[cod]
*$py.class

# MLflow local artifacts
mlruns/
.mlruns/
mlartifacts/

# Virtual environments
venv/
env/
.venv/

# Generated data and health microdata must remain local.
# Require a nonempty child name so DVC can inspect the directory itself.
/data/?*
*.parquet
*.arrow
*.feather
*.csv
*.tsv
*.xlsx
*.xls
**/Datos SIVIGILA/
**/Covariables/
**/sivigila_*/
**/sivigila_*
**/Datos_*_210.xlsx
/reports/data_quality/*.json
# Validated integration quality report of the master panel (aggregates only; cited by docs/data_dictionary.md).
!/reports/data_quality/integration_quality_fixed_20261020.json
.pytest_cache/

# Local API logs (src/api.py writes logs/api_<stage>.jsonl with request payloads).
/logs/

# Allow DVC tracking files directly in processed; keep datasets and subdirectories ignored.
!/data/processed/
/data/processed/?*
!/data/processed/*.dvc

# Final epidemiological Parquet remains ignored; permit only its future DVC descriptor and provenance.
!/data/processed/epidemiology/
/data/processed/epidemiology/?*
!/data/processed/epidemiology/pilot_weekly_labels.parquet.dvc
!/data/processed/epidemiology/run_manifest.json
# epiCo channel product (F1): only its DVC descriptor and adjacent manifest.
!/data/processed/epidemiology/pilot_weekly_channel.parquet.dvc
!/data/processed/epidemiology/pilot_weekly_channel_manifest.json

# Forecasting results (especificación §4): Parquet ignored; only DVC descriptors in Git.
!/data/processed/forecasting/
/data/processed/forecasting/?*
!/data/processed/forecasting/*.dvc
# D7.2 searches (reports/forecasting/INDICE.md): sin_clima/ (vigente) and ablacion_clima/ (registro), descriptors only.
!/data/processed/forecasting/sin_clima/
/data/processed/forecasting/sin_clima/?*
!/data/processed/forecasting/sin_clima/*.dvc
!/data/processed/forecasting/ablacion_clima/
/data/processed/forecasting/ablacion_clima/?*
!/data/processed/forecasting/ablacion_clima/*.dvc
# Single test run of F7 (prueba/): descriptors only; small tables are copied to reports/forecasting/evidence/.
!/data/processed/forecasting/prueba/
/data/processed/forecasting/prueba/?*
!/data/processed/forecasting/prueba/*.dvc

# DVC local cache
.dvc/cache/
.dvc/tmp/

# Temporary descriptive runs remain local. Explicit aggregate review evidence is eligible for Git.
/reports/pilot_selection/runs/
/reports/epidemiology/runs/
!/reports/pilot_selection/evidence/selection_20261020/*.csv
!/reports/epidemiology/evidence/labels_20261021/*.csv
!/reports/epidemiology/evidence/channel_20261111/*.csv
!/reports/forecasting/evidence/*/*.csv
